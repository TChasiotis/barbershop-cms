generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String   
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Service {
  id           String        @id @default(cuid())
  name         String
  nameEn       String        @default("")
  duration     String   
  price        String   
  sortOrder    Int           @default(0) 
  createdAt    DateTime      @default(now())
  // Η μόνη προσθήκη στο Service:
  appointments Appointment[] 
}

model Product {
  id        String   @id @default(cuid())
  name      String
  price     String
  desc      String
  descEn    String?
  img       String
  category  String
  sortOrder Int      @default(0)
  custom    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model ApiLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
}

model GalleryImage {
  id        String   @id @default(cuid())
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

// ΤΟ ΝΕΟ ΜΟΝΤΕΛΟ ΓΙΑ ΤΑ ΡΑΝΤΕΒΟΥ
model Appointment {
  id            String   @id @default(cuid())
  customerName  String
  customerPhone String
  customerEmail String?  // ΝΕΟ: Προαιρετικό Email
  paymentMethod String   @default("STORE") // ΝΕΟ: "STORE" ή "ONLINE"
  date          DateTime 
  time          String   
  status        String   @default("PENDING") 
  serviceId     String
  service       Service  @relation(fields: [serviceId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CustomerStrike {
  id        String   @id @default(cuid())
  phone     String   @unique
  email     String?
  strikes   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}